# Sao chép thành .env.local (đã gitignore) rồi điền giá trị thật. KHÔNG commit file có secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Supabase Session Pooler (cổng 5432, SSL). KHÔNG dùng transaction pooler 6543.
# Sao chép URI Session pooler từ Supabase Connect; không tự ghép hostname từ region.
# Thay placeholder mật khẩu, bỏ dấu ngoặc placeholder và percent-encode ký tự đặc biệt trong mật khẩu.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
# Bật endpoint /api/smoke/* (Giai đoạn 1). Bỏ trống để tắt.
SMOKE_TOKEN=
LLM_TIMEOUT_S=60
LLM_MAX_OUTPUT_TOKENS=2000
# Ngân sách
MAX_EMAIL_CHARS=4000
LLM_DAILY_CAP=300
VERIFY_DAILY_CAP=60
RATE_PER_IP_PER_MIN=6
LEASE_SECONDS=180
# Đơn giá USD / 1 triệu token để ƯỚC TÍNH chi phí trong Verify (bỏ trống => không ước tính)
PRICE_INPUT_PER_1M=
PRICE_OUTPUT_PER_1M=
